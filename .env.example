NAUKRI_EMAIL="your_email@example.com"
NAUKRI_PASSWORD="your_password_here"

# Scheduling Configuration:
# Set RANDOM_DAILY_TWICE=true to run randomly twice a day (morning and evening).
# Alternatively, set one of the static scheduling options below:
# UPDATE_EVERY_MINUTES=240
# UPDATE_AT_HHMM=09:30
RANDOM_DAILY_TWICE=true

# Optional Settings:
# PROFILE_URL=https://www.naukri.com/mnjuser/profile
# SESSION_FILE=naukri_session.json
